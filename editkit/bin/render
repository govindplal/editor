#!/usr/bin/env bash
# usage: editkit/bin/render <key> [--stills t1,t2,...] [--from a --to b] [--no-publish]
#  builds index.html from edit.json, then either a stills sheet (runs/<key>/qa/stills.jpg)
#  or the full video: runs/<key>/out/<key>.mp4 (+ -preview.mp4 if >29MB) and publishes to videos/<key>/
set -euo pipefail
. "$(dirname "$0")/_common.sh"
KEY=$1; shift; RUN=$ROOT/runs/$KEY
[ -f "$RUN/edit.json" ] || die "no runs/$KEY/edit.json"
STILLS=""; FROMTO=(); PUBLISH=1
while [ $# -gt 0 ]; do case $1 in
  --stills) STILLS=$2; shift 2;; --from|--to) FROMTO+=("$1" "$2"); shift 2;; --no-publish) PUBLISH=0; shift;; *) die "bad arg $1";; esac; done
python3 "$KIT/py/build.py" "$RUN"
FPS=$(meta "$RUN/meta.json" fps); DUR=$(meta "$RUN/meta.json" duration); SRC=$RUN/$(meta "$RUN/meta.json" source)
if [ -n "$STILLS" ]; then
  rm -rf "$RUN/qa/stills"
  $OE render "$RUN/index.html" --out "$RUN/qa/stills" --fps "$FPS" --duration "$DUR" --stills "$STILLS" --sheet "$RUN/qa/stills-full.jpg" 2>&1 | grep -iE "error|fail|warn" || true
  ffmpeg -v error -y -i "$RUN/qa/stills-full.jpg" -vf "scale='min(1400,iw)':-2" "$RUN/qa/stills.jpg" && rm -rf "$RUN/qa/stills" "$RUN/qa/stills-full.jpg"
  echo "[render] stills: runs/$KEY/qa/stills.jpg"; exit 0
fi
mkdir -p "$RUN/out"
$OE render "$RUN/index.html" --out "$RUN/out/silent.mp4" --fps "$FPS" --duration "$DUR" --workers "$(nproc)" "${FROMTO[@]}" 2>&1 | grep -E "error|fail|warn|wall" || true
[ -f "$RUN/out/silent.mp4" ] || die "render failed"
OUT=$RUN/out/$KEY.mp4
if [ "$(meta "$RUN/meta.json" audio)" = "None" ]; then cp "$RUN/out/silent.mp4" "$OUT"
elif ! ffmpeg -v error -y -i "$RUN/out/silent.mp4" -i "$SRC" -map 0:v -map 1:a -c copy -shortest -movflags +faststart "$OUT" 2>/dev/null; then
  ffmpeg -v error -y -i "$RUN/out/silent.mp4" -i "$SRC" -map 0:v -map 1:a -c:v copy -c:a aac -b:a 320k -shortest -movflags +faststart "$OUT"
  echo "[render] NOTE: source audio codec can't go in MP4 untouched; re-encoded to AAC 320k"
fi
SZ=$(stat -c %s "$OUT"); PREV=$OUT
if [ "$SZ" -gt 29000000 ]; then
  PREV=$RUN/out/$KEY-preview.mp4
  VB=$(python3 -c "print(max(300,int(27e6*8/$DUR/1000)-200))")
  ffmpeg -v error -y -i "$OUT" -vf "scale='if(gt(iw,ih),-2,min(720,iw))':'if(gt(iw,ih),min(720,ih),-2)'" -c:v libx264 -preset medium -b:v ${VB}k -maxrate ${VB}k -bufsize $((VB*2))k -c:a copy -movflags +faststart "$PREV"
fi
echo "[render] final: runs/$KEY/out/$KEY.mp4 ($((SZ/1000000)) MB)  send-to-user: ${PREV#$ROOT/}"
if [ $PUBLISH = 1 ]; then
  PUB=$ROOT/videos/$KEY; mkdir -p "$PUB"
  cp "$RUN"/{edit.json,meta.json,shots.json} "$PUB"/; for f in words.json transcript.txt; do [ -f "$RUN/$f" ] && cp "$RUN/$f" "$PUB"/; done
  [ "$(stat -c %s "$SRC")" -lt 50000000 ] && cp "$SRC" "$PUB"/ || echo "[render] source >50MB: not stored in git (re-upload to revise later)"
  if [ "$SZ" -lt 95000000 ]; then cp "$OUT" "$PUB/$KEY.mp4"; else echo "[render] final >95MB: too big for git, only the preview is shareable"; cp "$PREV" "$PUB/$KEY-preview.mp4" 2>/dev/null || true; fi
  echo "[render] published: videos/$KEY/"
fi
